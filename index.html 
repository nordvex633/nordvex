      </form>
    </div>
  </section>
</main>

<footer>
  <div class="wrap"><b>NORDVEX</b><span>Hemsidor för företag i Sverige</span></div>
</footer>

<script>
// Fyll i din e-postadress här när du har bestämt den, t.ex. "hej@nordvex.se"
const EMAIL = "nordvextkontakt@gmail.com";

const $ = id => document.getElementById(id);

const today = new Date(); today.setMinutes(today.getMinutes() - today.getTimezoneOffset());
const minDate = today.toISOString().slice(0,10);
$("datum").min = minDate;

document.querySelectorAll("[data-plan]").forEach(a => a.addEventListener("click", () => {
  $(a.dataset.plan === "fast" ? "p-fast" : "p-andr").checked = true;
}));

function check(id, ok){ $(id+"-err").hidden = ok; $(id).setAttribute("aria-invalid", ok ? "false" : "true"); return ok; }

$("bookForm").addEventListener("submit", async e => {
  e.preventDefault();
  const v = id => $(id).value.trim();
  const ok = [
    check("namn", v("namn").length > 1),
    check("tel", v("tel").replace(/\D/g,"").length >= 7),
    check("epost", /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v("epost"))),
    check("datum", !!v("datum") && v("datum") >= minDate)
  ].every(Boolean);
  if (!ok) { document.querySelector("[aria-invalid='true']").focus(); return; }

  const paket = document.querySelector("input[name=paket]:checked").value;
  const text =
`Bokningsförfrågan – Nordvex

Namn: ${v("namn")}
Företag: ${v("foretag") || "–"}
Telefon: ${v("tel")}
E-post: ${v("epost")}
Paket: ${paket}
Önskat samtal: ${v("datum")}, ${$("tid").value}

${v("medd") || ""}`.trim();

  $("summary").textContent = text;
  $("mailLink").hidden = true;
  const btn = document.querySelector(".submit .btn");
  btn.disabled = true; btn.textContent = "Skickar…";

  const showFallback = () => {
    $("resultHead").textContent = "Nästan klart.";
    $("resultText").textContent = "Förfrågan kunde inte skickas automatiskt. Kopiera texten nedan och mejla den till " + EMAIL + ".";
    $("summary").hidden = false; $("copyBtn").hidden = false;
  };
  const showSent = () => {
    $("resultHead").textContent = "Tack!";
    $("resultText").textContent = "Din förfrågan är skickad. Vi hör av oss och bekräftar tiden via mejl.";
    $("summary").hidden = true; $("copyBtn").hidden = true;
    $("bookForm").querySelectorAll("input:not([type=radio]),textarea").forEach(el => el.value = "");
  };

  try {
    const res = await fetch("https://api.web3forms.com/submit", {
      method: "POST",
      headers: { "Content-Type": "application/json", "Accept": "application/json" },
      body: JSON.stringify({
        access_key: "43e62e17-9fbb-41c5-bb1e-f7dade99fae4",
        subject: "Ny bokning från hemsidan – " + v("namn"),
        from_name: "Nordvex hemsida",
        replyto: v("epost"),
        Namn: v("namn"),
        Företag: v("foretag") || "–",
        Telefon: v("tel"),
        "E-post": v("epost"),
        Paket: paket,
        "Önskat samtal": v("datum") + ", " + $("tid").value,
        Meddelande: v("medd") || "–"
      })
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok && String(data.success) === "true") showSent(); else showFallback();
  } catch (_) { showFallback(); }

  btn.disabled = false; btn.textContent = "Skicka förfrågan";
  $("result").hidden = false;
  $("result").scrollIntoView({block:"nearest"});
});

$("copyMail").addEventListener("click", () => {
  const b = $("copyMail");
  const done = () => { b.textContent = "Kopierad"; setTimeout(()=>b.textContent="Kopiera",1800); };
  const sel = () => { const r=document.createRange(); r.selectNodeContents($("mailText")); const s=getSelection(); s.removeAllRanges(); s.addRange(r); };
  try { navigator.clipboard.writeText(EMAIL).then(done).catch(sel); } catch(_) { sel(); }
});

$("copyBtn").addEventListener("click", () => {
  const t = $("summary").textContent;
  const done = () => { $("copyBtn").textContent = "Kopierat"; setTimeout(()=>$("copyBtn").textContent="Kopiera texten",1800); };
  try {
    navigator.clipboard.writeText(t).then(done).catch(selectIt);
  } catch(_) { selectIt(); }
  function selectIt(){ const r=document.createRange(); r.selectNodeContents($("summary")); const s=getSelection(); s.removeAllRanges(); s.addRange(r); }
});
</script>

