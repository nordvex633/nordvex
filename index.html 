            <label class="choice"><input type="radio" name="paket" id="p-fast" value="Fast hemsida (899 kr + 1 500 kr/mån)"><span><b>Fast hemsida</b>899 kr + 1 500 kr/mån</span></label>
            <label class="choice"><input type="radio" name="paket" id="p-andr" value="Hemsida med ändringar (899 kr + 2 000 kr/mån)" checked><span><b>Med ändringar</b>899 kr + 2 000 kr/mån</span></label>
            <label class="choice"><input type="radio" name="paket" id="p-vet" value="Vet inte än"><span><b>Vet inte än</b>Vi pratar om det</span></label>
