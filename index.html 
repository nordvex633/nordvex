        <div class="mailbox">
          <span class="label">E-post</span>
          <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center"><code id="mailText" style="user-select:all">nordvextkontakt@gmail.com</code><button class="btn" type="button" id="copyMail" style="background:var(--ink);color:var(--bg);padding:8px 14px;font-size:14px">Kopiera</button></div>
